    jmvcore,
    R6,
    EGAnet (>= 2.4.0),
    lavaan,
    NetworkComparisonTest,
    bootnet,
    qgraph,
    sna,
    ggplot2,
    graphics,
    grDevices,
    stats,
    utils
Suggests:
    testthat (>= 3.2.0),
    withr
Encoding: UTF-8
