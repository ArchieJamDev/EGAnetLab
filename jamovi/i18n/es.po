msgstr "Bootstrap"

#: R/texts.R
msgid "Bootstrap complete: %d samples (%s), seed %d. Changing only the stability cutoff or the plot options reuses these results without running the bootstrap again."
msgstr "Bootstrap completado: %d muestras (%s), semilla %d. Si cambia solo el punto de corte de estabilidad o las opciones de gráfico, se reutilizan estos resultados sin volver a ejecutar el bootstrap."

#: ega/options/iter.title
msgid "Bootstrap samples"
msgstr "Muestras bootstrap"

#: ega/options/bnCaseIter.title
msgid "Bootstrap samples (dropping cases)"
msgstr "Muestras bootstrap (eliminando casos)"

